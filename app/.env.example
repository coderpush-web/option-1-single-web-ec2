# Environment Configuration Template for Option 1 (Stateless Web EC2)

# NextAuth session encryption secret (minimum 32-character random string)
# Generated dynamically in AWS Secrets Manager: ${EnvironmentName}-web-auth-secret
AUTH_SECRET=your_32_character_nextauth_secret_key_here

# Canonical base URL for NextAuth authentication redirects
AUTH_URL=http://localhost:3000

# Application environment tier (development | staging | production)
APP_ENV=development

# Application listening port (defaults to 80 in Docker, 3000 in local dev)
PORT=3000

# Optional demo user credentials for stateless mode without database
# DEMO_USER_EMAIL=user@nextmail.com
# DEMO_USER_PASSWORD=your_secure_demo_password

# Optional PostgreSQL database connection strings (if connected to an external DB)
# POSTGRES_URL=postgres://appuser:apppassword@10.0.10.50:5432/appdb?sslmode=require
# DATABASE_URL=postgres://appuser:apppassword@10.0.10.50:5432/appdb?sslmode=require
